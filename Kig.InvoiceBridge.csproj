<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>invoicebridge</AssemblyName>
    <RootNamespace>Kig.InvoiceBridge</RootNamespace>
    <AppHostDotNetSearch>AppRelative</AppHostDotNetSearch>
    <AppHostRelativeDotNet>runtime</AppHostRelativeDotNet>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;server/**</DefaultItemExcludes>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages</RestorePackagesPath>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="[0.1.15]" />
    <PackageReference Include="ZUGFeRD-csharp" Version="[18.0.1]" />
    <PackageReference Include="ZXing.Net" Version="[0.16.11]" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="InvoiceBridge.Http" />
    <None Update="invoicebridge.json" Condition="'$(IncludeLocalInvoiceConfig)' != 'false'" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="invoicebridge.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
